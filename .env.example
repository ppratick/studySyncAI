# Copy to .env (ignored). Use your own Canvas token; never commit it.
CANVAS_API_TOKEN=
# Hostname only, without https:// or /api/v1
CANVAS_DOMAIN=canvas.example.edu
# Set to a model installed in your local Ollama. Required by the current web setup.
# The CLI works without Ollama when --ai is omitted.
OLLAMA_MODEL=
